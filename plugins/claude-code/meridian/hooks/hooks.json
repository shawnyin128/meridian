{
  "description": "Meridian Lab Focus: prints which Lab research nodes are active at session start and before each prompt, so the agent activates/reopens nodes instead of guessing. Silent outside a Meridian Lab or workspace repository.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/run.py",
              "meridian",
              "lab",
              "focus",
              "--hook"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/lib/run.py",
              "meridian",
              "lab",
              "focus",
              "--hook"
            ]
          }
        ]
      }
    ]
  }
}
